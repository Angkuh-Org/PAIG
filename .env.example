# PAIG environment template.
# Copy to .env (repo-local) or ~/.config/paig/.env (user-wide).
# Precedence: defaults < config.json < .env < process environment.

# Server
PAIG_HOST=127.0.0.1
PAIG_PORT=8899
PAIG_DEBUG=0
# PAIG_ADVISOR_MAX_BYTES=1000000
# PAIG_LEDGER=/tmp/paig-ledger.jsonl

# Command Code upstream (required for unprefixed models)
CC_API_BASE=https://api.commandcode.ai
CC_API_KEY=
# Optional: read the key from a JSON file or a plain-text key file instead.
# CC_API_KEY_FILE=~/.config/paig/commandcode.key
CC_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
# CC_MODELS=deepseek/deepseek-v4.1-flash
# PAIG_EXCLUDED_MODELS=claude-opus-5,gpt-5.5
# CC_REASONING_EFFORT=medium
# CC_PERMISSION_MODE=standard
# CC_THREAD_ID=
# CC_FETCH_RETRIES=2
# CC_FETCH_BACKOFF_MS=500

# Identity headers sent to the Command Code upstream. The endpoint rejects
# requests that do not look like the CLI, so these defaults are intentional.
# CC_USER_AGENT=cli
# CC_CLI_VERSION=1.88.0
# CC_CLI_ENVIRONMENT=production
# CC_TASTE_LEARNING=true

# OpenCode (opencode/<id> keyless free, opencode-go/<id> keyed Go)
# The key can come from here, opencode.apiKeyFile, or an OpenCode CLI login.
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_FREE_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_API_KEY=
# OPENCODE_API_KEY_FILE=~/.config/paig/opencode.key
# OPENCODE_BIN=~/.opencode/bin/opencode
# OPENCODE_MODELS=beam-free,big-pickle,crouton-alpha-free,deepseek-v4.1-flash-free,flint-40b-free,glm-5.3-flash-free,mimo-v2.6-flash-free,nemotron-3.5-lightning-free,nemotron-3.5-super-vl-free,pulse-alpha-free
# OPENCODE_GO_MODELS=beam-free,crouton-alpha-free,iceman-contributor-free
# OPENCODE_TIMEOUT_MS=180000

# Kilo gateway
KILO_API_BASE=https://ai-gateway.kilo.ai/api/v1
KILO_API_KEY=
# KILO_ALL_MODELS=1

# Bob gateway (models exposed as bob/<alias>)
PAIG_BOB_BASE_URL=https://api.us-east.bob.ibm.com/inference/v1
PAIG_BOB_API_KEY=
# PAIG_BOB_API_KEY_FILE=~/.config/paig/bob.key
# PAIG_BOB_TEAM_ID=
# PAIG_BOB_USER_AGENT=bob-shell/2.0.9

# Mistral API (models exposed as mistral/<id>)
PAIG_MISTRAL_BASE_URL=https://api.mistral.ai/v1
PAIG_MISTRAL_API_KEY=
# PAIG_MISTRAL_API_KEY_FILE=~/.config/paig/mistral.key
# Curated chat models; unset lists every chat-capable model from /v1/models.
# PAIG_MISTRAL_MODELS=mistral-large-4,codestral-latest,ministral-8b-latest
